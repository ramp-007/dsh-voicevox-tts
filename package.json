{
  "name": "dsh-voicevox-tts",
  "version": "0.1.3",
  "description": "Unofficial DeepSeek Harness plugin that reads assistant replies aloud with a local VOICEVOX Engine.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.ja.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "voicevox",
    "tts",
    "text-to-speech",
    "plugin",
    "japanese",
    "local-tts"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "node scripts/verify-package.mjs",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run verify"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "marked": "^18.1.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
